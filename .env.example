ELASTICSEARCH_URL=https://your-project.es.region.aws.elastic.cloud
# Ingestion/bootstrap key with permissions to index and manage roles/mappings
ELASTICSEARCH_API_KEY_SYSTEM=your_ingestion_api_key

# Create these manually in Kibana (API keys UI), one per role/profile
ELASTICSEARCH_API_KEY_PUBLIC=your_public_profile_api_key
ELASTICSEARCH_API_KEY_BILLING=your_billing_profile_api_key
ELASTICSEARCH_API_KEY_INTERNAL=your_internal_profile_api_key
